{$API_DOMAIN} {
	encode zstd gzip

	header {
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		-Server
	}

	reverse_proxy api:3001 {
		health_uri /health
		health_interval 30s
		health_timeout 5s
		transport http {
			read_timeout 10m
			write_timeout 10m
		}
	}

	log {
		output stdout
		format console
	}
}
