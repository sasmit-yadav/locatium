# Public HTTPS hostname pointing to the Oracle VM, for example:
# API_DOMAIN=api-locatium.duckdns.org
API_DOMAIN=
PUBLIC_APP_URL=https://locatium-eta.vercel.app

# Use URL-safe random values (letters/numbers) for POSTGRES_PASSWORD.
POSTGRES_PASSWORD=
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=

DEMO_USER_EMAIL=demo@locatium.app
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=

# Optional AI
LLM_ENABLED=false
GROQ_API_KEY=
LLM_MODEL=openai/gpt-oss-120b
LLM_BASE_URL=https://api.groq.com/openai/v1

# Optional real email delivery
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

INVESTOR_ALERTS_ENABLED=false
INVESTOR_CACHE_WARM=true
