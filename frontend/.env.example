# Must match backend PORT. Showcase / this repo usually uses 3002.
VITE_API_URL=http://localhost:3002

# Production showcase is set by ops/tunnel (Cloudflare URL), not a public Render host.

# Shown on the Terms / Privacy pages and used as the grievance contact (DPDP Act).
VITE_OPERATOR_NAME=
VITE_CONTACT_EMAIL=
# Show the experimental ML score badge (keep false for the public site).
VITE_SHOW_EXPERIMENTAL_ML=false
# Map-only layers are drawn from static files in public/tiles (see src/config/static-tiles.js).
# Set false to draw every layer from the API instead (only works with the full database).
VITE_STATIC_TILES=true
