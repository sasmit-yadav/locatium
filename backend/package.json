{
  "name": "locatium-api",
  "version": "0.1.0",
  "private": true,
  "description": "LOCATIUM backend — location intelligence API for Haryana",
  "main": "src/server.js",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "db:migrate": "node db/migrate.js",
    "db:bootstrap": "node scripts/bootstrap-users.js",
    "db:inspect": "node scripts/inspect-database.js",
    "verify": "node scripts/verify-setup.js",
    "deploy:verify": "node scripts/verify-deployment.js",
    "test": "node --test tests/scoring-engine.test.js tests/scoring-orchestrator.test.js tests/investor-opportunity.engine.test.js tests/assistant.test.js tests/assistant-upgrades.test.js tests/assistant-multilingual.test.js tests/score-insights.land.test.js tests/land-value.service.test.js tests/roadmap-features.test.js tests/model-health.test.js tests/heavy-work-guard.test.js tests/plot-tools.test.js",
    "test:portal": "node scripts/test-portal.js",
    "test:investor": "node scripts/test-investor-api.js",
    "test:investor-portal": "node scripts/test-investor-portal.js",
    "warm:investor": "node scripts/warm-investor-cache.js",
    "test:smoke": "node scripts/test-api-smoke.js",
    "test:ml": "node scripts/test-ml-integration.js",
    "train:ml": "cd ../ml-service && python scripts/train_investment_model.py",
    "refresh:zone-features": "node scripts/refresh-zone-features.js",
    "alerts:run": "node scripts/run-investor-alerts.js"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.0",
    "express-rate-limit": "^7.5.0",
    "ioredis": "^5.4.2",
    "jsonwebtoken": "^9.0.2",
    "nodemailer": "^9.0.3",
    "pdfkit": "^0.19.1",
    "pg": "^8.13.1"
  }
}
