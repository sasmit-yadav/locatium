# Runtime
NODE_ENV=development
PORT=3002
PUBLIC_APP_URL=http://localhost:5173
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
ALLOW_VERCEL_PREVIEWS=false

# PostgreSQL + PostGIS
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/locatium
DATABASE_SSL=false
PG_POOL_MAX=12
PG_STATEMENT_TIMEOUT_MS=60000
PG_QUERY_TIMEOUT_MS=90000
REQUIRE_SPATIAL_DATA=false
ALLOW_PARTIAL_SPATIAL_MIGRATION=true

# Authentication (generate independent values of at least 32 characters)
JWT_ACCESS_SECRET=replace-with-a-long-random-secret
JWT_REFRESH_SECRET=replace-with-a-different-long-random-secret
# Keep access tokens short; the frontend renews them silently with the refresh token.
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=30d
PASSWORD_MIN_LENGTH=12

# Optional public showcase login. Run `npm run db:bootstrap` after setting these.
DEMO_MODE=false
DEMO_USER_EMAIL=demo@example.com
# Each showcase visitor gets a private throwaway investor account (default).
# Set DEMO_ISOLATED=false to fall back to the single shared DEMO_USER_EMAIL account.
DEMO_ISOLATED=true
DEMO_TTL_DAYS=7
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=
BOOTSTRAP_DEMO_EMAIL=demo@example.com
BOOTSTRAP_DEMO_PASSWORD=
TEST_USER_EMAIL=
TEST_USER_PASSWORD=

# Cache
REDIS_URL=
TILE_CACHE_TTL_SEC=86400
MAP_QUERY_CACHE_TTL_SEC=3600

# ML service. Leave blank to use deterministic heuristic fallback.
ML_SERVICE_URL=http://127.0.0.1:8000
ML_SERVICE_TIMEOUT_MS=75000

# Optional LLM and speech (Ask LOCATIUM)
LLM_ENABLED=false
GROQ_API_KEY=
LLM_MODEL=openai/gpt-oss-120b
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_FAST_MODEL=openai/gpt-oss-20b
# Cascade tried when the primary model errors (e.g. the provider retires a model id).
LLM_FALLBACK_MODELS=qwen/qwen3.8-27b,openai/gpt-oss-20b
# Reasoning models bill hidden reasoning against max_tokens; keep it low for chat latency.
LLM_REASONING_EFFORT=low
ASSISTANT_CONTEXT_TOKEN_BUDGET=1400
ASSISTANT_GROUNDING_BUDGET_MS=12000
ASSISTANT_CANDIDATE_CAP=12
ASSISTANT_LLM_MAX_TOKENS=420
ASSISTANT_LLM_TIMEOUT_MS=20000
ASSISTANT_ANSWER_CACHE_TTL_MS=300000
SPEECH_ENABLED=true
SPEECH_MODEL=whisper-large-v3-turbo

# Optional email delivery
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# ── Real user accounts ──────────────────────────────────────────────────────
# (PUBLIC_APP_URL at the top of this file is the frontend URL used in verify / reset emails.)
# Set to false to close new sign-ups (guests can still use the app).
ALLOW_PUBLIC_REGISTRATION=true

# ── Daily per-user limits ───────────────────────────────────────────────────
ASSISTANT_DAILY_LIMIT=60
ASSISTANT_DEMO_DAILY_LIMIT=20
EMAIL_REPORT_DAILY_LIMIT=10

# ── Housekeeping ────────────────────────────────────────────────────────────
# Generated PDFs / outbox files older than this are deleted from disk (reports stay in PostgreSQL).
REPORT_FILE_RETENTION_DAYS=14

# Optional: POST a short JSON alert here on server errors (Slack / Discord / ntfy webhook URL).
ALERT_WEBHOOK_URL=

# Scheduled jobs
INVESTOR_ALERTS_ENABLED=false
INVESTOR_ALERT_INTERVAL_MS=3600000
# Warm the investor shortlist at boot. A cold statewide scan costs ~33s, so leaving
# this off means the first visitor pays it. Recommended on for any hosted instance.
INVESTOR_CACHE_WARM=true
